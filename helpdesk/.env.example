APP_NAME="Dabaw Helpdesk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/helpdesk
ASSET_URL=/helpdesk/public
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
