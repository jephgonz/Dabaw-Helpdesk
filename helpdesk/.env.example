DB_SSL_CA=config/certs/ca.pem
SESSION_DRIVER=file
SESSION_COOKIE=dabaw_helpdesk_laravel


# Used only by php bin/setup.php when creating the first administrator.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
